SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=YOUR_DB_USER
SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
ADMIN_PIN=YOUR_PIN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YOUR_PASSWORD

ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@company.com
MAIL_PASSWORD=your-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
SAFETY_EMAIL_RECIPIENT=safety1@company.com,safety2@company.com
SAFETY_EMAIL_CC=manager@company.com,head@company.com
